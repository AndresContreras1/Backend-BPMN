# Copiar como .env y cambiar los valores. El archivo .env no se sube al repositorio.
DB_NAME=procesos
DB_USER=bpmn
DB_PASSWORD=cambiar-esta-clave
CORS_ALLOWED_ORIGINS=http://localhost:4200
# prod,demo carga las empresas y usuarios de demostracion en PostgreSQL
SPRING_PROFILES_ACTIVE=prod,demo
# Clave JWT en Base64 de al menos 32 bytes. Generarla con: openssl rand -base64 64
# Si se deja vacia, el backend genera una temporal y los tokens no sobreviven a un reinicio.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=1800
# Base de PostgreSQL creada antes de las migraciones: true una sola vez para conservarla
FLYWAY_BASELINE_ON_MIGRATE=false
# Intentos de login por IP cada minuto y registros de empresa por IP cada hora
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTRO=10
